# Local development (default outside Vercel). Node 24.x required.
CARVIEW_MODE=local
PORT=3001
HOST=0.0.0.0
DATA_DIR=.data
# APP_ORIGIN=https://360-app-three.vercel.app

# Vercel + Supabase: enter real server-only values in Vercel settings.
# CARVIEW_MODE=supabase
# SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# DATABASE_URL=postgresql://USER:URL-ENCODED-PASSWORD@YOUR-POOLER:6543/postgres
# SUPABASE_SECRET_KEY=SERVER-SECRET-KEY-ONLY
# SUPABASE_STORAGE_BUCKET=carview-private
# SUPABASE_DB_CA_CERT=optional project database CA PEM
# Legacy service_role keys can use SUPABASE_SERVICE_ROLE_KEY instead.
# Never put database URLs or secret/service keys in VITE_* variables or Git.
