# Node 24+. No external services required for local development.
PORT=3001
HOST=0.0.0.0
DATA_DIR=.data
# Production: set to the HTTPS origin; serves built frontend and API together.
# APP_ORIGIN=https://carview.example.com
# NODE_ENV=production

# Render injects RENDER_EXTERNAL_URL automatically. APP_ORIGIN overrides it
# for custom domains. DATA_DIR must live on a persistent private disk.

# Vercel frontend BUILD setting: origin of the persistent backend (not Vercel).
# CARVIEW_BACKEND_URL=https://YOUR-PERSISTENT-BACKEND
# Backend APP_ORIGIN must be your exact Vercel production origin.
