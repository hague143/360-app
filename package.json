{
  "name": "carview-pakistan",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web \"node --watch server/index.js\" \"vite --host 0.0.0.0\"",
    "build": "tsc --noEmit && vite build",
    "start": "NODE_ENV=production node server/index.js",
    "test": "node --test --test-concurrency=1 tests/api.test.js tests/deployment.test.js tests/supabase-unit.test.js",
    "test:browser": "node tests/browser.mjs && node tests/spin-browser.mjs && node tests/deployment-browser.mjs",
    "create-admin": "node server/create-admin.js",
    "build:vercel": "npm run build",
    "test:supabase": "node --test --test-concurrency=1 tests/supabase.test.js && node tests/supabase-browser.mjs",
    "local": "node scripts/start-local.mjs",
    "test:local-package": "node tests/local-package.mjs",
    "test:browser-file": "python scripts/package-browser.py && node tests/browser-file.mjs",
    "package:ai-demo": "node scripts/package-ai-demo.mjs",
    "test:browser-media": "python scripts/package-browser.py && node tests/browser-media.mjs",
    "package:marketplace": "node scripts/package-marketplace.mjs",
    "test:marketplace": "node scripts/package-marketplace.mjs && node tests/marketplace-browser.mjs"
  },
  "dependencies": {
    "@fontsource/dm-sans": "^5.3.0",
    "@fontsource/manrope": "^5.3.0",
    "@supabase/supabase-js": "^2.118.0",
    "express": "^5.1.0",
    "helmet": "^8.1.0",
    "lucide-react": "^0.555.0",
    "multer": "^2.0.2",
    "pg": "^8.23.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "sharp": "^0.35.5",
    "three": "^0.181.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@types/three": "^0.181.0",
    "@vitejs/plugin-react": "^5.1.1",
    "concurrently": "^9.2.1",
    "playwright-core": "^1.56.1",
    "prettier": "^3.9.10",
    "typescript": "^5.9.3",
    "vite": "^7.2.2"
  }
}
